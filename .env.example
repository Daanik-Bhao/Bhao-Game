# Copy to .env (or .env.local) and fill in. Without the Supabase values the app
# still runs in offline guest mode (bots + tutorial + campaign only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Sentry error tracking. Leave empty to disable Sentry entirely.
VITE_SENTRY_DSN=

# Optional: TURN relay for in-game voice chat. Without it voice uses STUN only and
# fails for some players behind strict mobile/corporate NATs. Comma-separate URLs.
# VITE_TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
