# Copy to .env (or .env.local) and fill in. Without the Supabase values the app
# still runs in offline guest mode (bots + tutorial + campaign only).
# Check your values with: npm run env:check
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key (Supabase dashboard > Project Settings > API).
# NEVER put the service_role / sb_secret_ key here: every VITE_ value is bundled
# into the app and anyone can read it.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Sentry error tracking. Leave empty to disable Sentry entirely.
VITE_SENTRY_DSN=

# Optional: TURN relay for in-game voice chat. Without it voice uses STUN only and
# fails for some players behind strict mobile/corporate NATs. Comma-separate URLs.
# VITE_TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# ==== Edge function secrets ====
# Keys declared (uncommented) in this section are pushed to the Supabase edge
# functions by `npm run supabase:deploy -- --apply` via `supabase secrets set`,
# using the value from your shell or .env / .env.local. They are NOT used by the app.
# Rules: no VITE_ prefix (that would bundle it into the app) and no SUPABASE_ prefix
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically and the CLI refuses to set them).
# Empty values are skipped with a warning (the parent-consent function then answers
# email_not_configured instead of sending parent consent emails).
#
# Parent consent emails (supabase/functions/parent-consent), sent with Resend:
# API key from resend.com > API Keys.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. BHAO <consent@daanik.com>
CONSENT_FROM_EMAIL=
# Public web address of the app, no trailing slash, e.g. https://bhao.daanik.com
# (the emailed links point to <PUBLIC_SITE_URL>/parent-consent?token=...).
PUBLIC_SITE_URL=
# Local testing only: also print the consent / withdraw links to the function log.
# CONSENT_DEV_LOG_LINKS=true
# ==== end Edge function secrets ====

# ==== Deploy-only (never bundled into the app) ====
# Used by `npm run supabase:deploy` only. Prefer setting these in your shell for the
# one deploy session instead of saving them in a file:
#   PowerShell:  $env:SUPABASE_ACCESS_TOKEN = "sbp_..."
#   bash:        export SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_ACCESS_TOKEN=     # personal token: supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF=      # 20 letters; also derived from VITE_SUPABASE_URL
# SUPABASE_DB_PASSWORD=      # database password (asked for if missing)
# ==== end Deploy-only ====
