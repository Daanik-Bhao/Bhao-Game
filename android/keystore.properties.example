# `npm run android:keystore` creates the upload keystore and writes android/keystore.properties
# (git-ignored) for you. Only copy this file by hand if you already have a keystore.
# storeFile: absolute path (forward slashes) or a path relative to the android/ folder.
# Keep the .jks OUTSIDE the repo and back it up; see docs/android-build.md.
# Passwords: a backslash must be written as \\ (Java .properties escaping).
storeFile=C:/Users/Administrator/AndroidDev/keys/bhao-upload.jks
storePassword=CHANGE_ME
keyAlias=bhao-upload
keyPassword=CHANGE_ME
