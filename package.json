{
  "name": "bhao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run --passWithNoTests",
    "icons": "node scripts/generate-icons.js",
    "check:migrations": "node scripts/check-migrations.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "check:functions": "node scripts/build-functions.mjs --check",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-gradle.mjs apk",
    "android:bundle": "node scripts/android-gradle.mjs bundle-check && npm run android:sync && node scripts/android-gradle.mjs bundle",
    "android:keystore": "node scripts/android-keystore.mjs",
    "version:show": "node scripts/version.mjs",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.45.0",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.28.0",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^25.0.1",
    "sharp": "0.35.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
